---
export interface Props {
	release: string;
	due: string;
	weight: string;
	hardware: string[];
	mainArtifact: string;
	evaluationMode: string;
}

const { release, due, weight, hardware, mainArtifact, evaluationMode } = Astro.props;
---

<section class="hol-assignment-glance" aria-label="Assignment at a glance">
	<div class="hol-assignment-glance-head">
		<span>At a glance</span>
		<strong>{weight}</strong>
	</div>
	<dl>
		<div>
			<dt>Release</dt>
			<dd>{release}</dd>
		</div>
		<div>
			<dt>Due</dt>
			<dd>{due}</dd>
		</div>
		<div>
			<dt>Required hardware/software</dt>
			<dd>
				<ul>
					{hardware.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</dd>
		</div>
		<div>
			<dt>Main artifact</dt>
			<dd>{mainArtifact}</dd>
		</div>
		<div>
			<dt>Evaluation mode</dt>
			<dd>{evaluationMode}</dd>
		</div>
	</dl>
</section>

<style>
	.hol-assignment-glance {
		border: 1px solid var(--hol-border, var(--sl-color-gray-5));
		border-radius: var(--hol-radius-card, 8px);
		padding: 1rem;
		margin: 1rem 0 1.25rem;
		background: var(--hol-surface, transparent);
		box-shadow: var(--hol-shadow, none);
	}

	.hol-assignment-glance-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.8rem;
	}

	.hol-assignment-glance-head span {
		color: color-mix(in oklab, var(--hol-teal, var(--sl-color-accent)), var(--sl-color-gray-2) 20%);
		font-family: var(--__sl-font-mono);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.hol-assignment-glance-head strong {
		border: 1px solid color-mix(in oklab, var(--hol-gold, #fbbf24), var(--sl-color-gray-5) 55%);
		border-radius: var(--hol-radius, 6px);
		padding: 0.18rem 0.65rem;
		background: color-mix(in oklab, var(--hol-gold, #fbbf24), transparent 86%);
		color: var(--sl-color-gray-1);
	}

	.hol-assignment-glance dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
		gap: 0.85rem;
		margin: 0;
	}

	.hol-assignment-glance dl > div {
		min-width: 0;
		margin-top: 0;
	}

	.hol-assignment-glance dt {
		color: var(--sl-color-gray-3);
		font-family: var(--__sl-font-mono);
		font-size: 0.78rem;
		font-weight: 750;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.hol-assignment-glance dd {
		margin: 0.25rem 0 0;
		color: var(--sl-color-gray-1);
		font-weight: 650;
	}

	.hol-assignment-glance ul {
		margin: 0.25rem 0 0;
		padding-left: 1.1rem;
		color: var(--sl-color-gray-2);
		font-weight: 500;
	}
</style>
