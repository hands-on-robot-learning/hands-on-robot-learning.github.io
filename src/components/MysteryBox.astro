---
export interface Props {
	title?: string;
	variant?: 'mystery' | 'challenge' | 'tip';
}

const { title = 'Mystery Box', variant = 'mystery' } = Astro.props;
---

<aside class="hol-box" data-variant={variant} aria-label={title}>
	<div class="hol-box-head">
		<span class="hol-box-title">{title}</span>
	</div>
	<div class="hol-box-body">
		<slot />
	</div>
</aside>

<style>
	.hol-box {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		padding: 0.9rem 1rem;
		background: color-mix(in oklab, var(--sl-color-gray-7), transparent 65%);
		margin: 1rem 0;
	}
	.hol-box-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}
	.hol-box-title {
		font-weight: 700;
	}
	.hol-box[data-variant='challenge'] {
		border-color: color-mix(in oklab, #f59e0b, var(--sl-color-gray-5) 65%);
		background: color-mix(in oklab, rgba(245, 158, 11, 0.12), var(--sl-color-gray-7) 80%);
	}
	.hol-box[data-variant='tip'] {
		border-color: color-mix(in oklab, #06b6d4, var(--sl-color-gray-5) 65%);
		background: color-mix(in oklab, rgba(6, 182, 212, 0.12), var(--sl-color-gray-7) 80%);
	}
</style>
