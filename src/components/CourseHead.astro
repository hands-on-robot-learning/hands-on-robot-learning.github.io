---
const path = Astro.url.pathname;
const { head } = Astro.locals.starlightRoute;
const isAssignmentDetail = /^\/assignments\/a\d/.test(path);
const isGuideDetail = path.startsWith('/guides/') && path !== '/guides/';
const isPolicyDetail = path.startsWith('/policies/') && path !== '/policies/';
const useCourseCard = !(isAssignmentDetail || isGuideDetail || isPolicyDetail || path.startsWith('/404'));
const courseCard = 'https://hands-on-robot-learning.github.io/og.png?v=20260911';

const normalizedHead = head.map((entry) => {
	if (path !== '/') return entry;
	if (entry.tag === 'title') return { ...entry, content: 'Hands-on Robot Learning' };
	if (
		entry.tag === 'meta' &&
		(entry.attrs?.property === 'og:title' || entry.attrs?.name === 'twitter:title')
	) {
		return { ...entry, attrs: { ...entry.attrs, content: 'Hands-on Robot Learning' } };
	}
	return entry;
});
---

{normalizedHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{useCourseCard && (
	<>
		<meta property="og:image" content={courseCard} />
		<meta property="og:image:alt" content="Annotated SO-101 robot arm showing its joints and links" />
		<meta property="og:image:width" content="1628" />
		<meta property="og:image:height" content="1000" />
		<meta name="twitter:image" content={courseCard} />
	</>
)}
