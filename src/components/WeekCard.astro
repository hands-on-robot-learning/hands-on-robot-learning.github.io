---
export interface Props {
	week: number | string;
	dates?: string;
	title: string;
	lectureTitle?: string;
	topics?: string[];
	labFocus?: string;
	milestone?: string;
	note?: string;
	tags?: string[];
	variant?: 'full' | 'compact';
}

const {
	week,
	dates,
	title,
	lectureTitle,
	topics = [],
	labFocus,
	milestone,
	note,
	tags = [],
	variant = 'full',
} = Astro.props;

const milestoneItems =
	milestone
		?.split(';')
		.map((item) => item.trim())
		.filter(Boolean) ?? [];

const milestoneKind = (item: string) => {
	const lower = item.toLowerCase();
	if (lower.includes('released')) return 'release';
	if (lower.includes('due')) return 'due';
	if (lower.includes('showcase') || lower.includes('demo')) return 'demo';
	if (lower.includes('check-in') || lower.includes('checkpoint') || lower.includes('dry run')) return 'checkpoint';
	return 'default';
};
---

<article class:list={['hol-week-card', `hol-week-card--${variant}`]} aria-labelledby={`week-${week}`}>
	<header class="hol-week-card-header">
		<div class="hol-week-card-kicker">
			<span class="hol-week-number">Week {week}</span>
			{dates ? <span class="hol-week-date">{dates}</span> : null}
		</div>
		<h2 id={`week-${week}`}>{title}</h2>
		{lectureTitle ? <p class="hol-week-lecture">{lectureTitle}</p> : null}
	</header>

	{tags.length ? (
		<div class="hol-week-tags" aria-label="Schedule tags">
			{tags.map((tag) => (
				<span>{tag}</span>
			))}
		</div>
	) : null}

	<div class="hol-week-card-grid">
		{labFocus ? (
			<section>
				<h3>Lab focus</h3>
				<p>{labFocus}</p>
			</section>
		) : null}

		{milestoneItems.length ? (
			<section>
				<h3>Milestone</h3>
				<div class="hol-week-milestones">
					{milestoneItems.map((item) => (
						<span data-kind={milestoneKind(item)}>{item}</span>
					))}
				</div>
			</section>
		) : null}
	</div>

	{topics.length || note ? (
		<details class="hol-week-details">
			<summary>Topics and notes</summary>
			<div class="hol-week-details-body">
				{topics.length ? (
					<section>
						<h3>Core topics</h3>
						<ul>
							{topics.map((topic) => (
								<li>{topic}</li>
							))}
						</ul>
					</section>
				) : null}
				{note ? (
					<section class="hol-week-note">
						<h3>Note</h3>
						<p>{note}</p>
					</section>
				) : null}
			</div>
		</details>
	) : null}
</article>

<style>
	.hol-week-card {
		position: relative;
		border: 1px solid var(--hol-border, var(--sl-color-gray-5));
		border-left: 0.32rem solid color-mix(in oklab, var(--hol-blue, var(--sl-color-accent)), var(--hol-border, var(--sl-color-gray-5)) 35%);
		border-radius: var(--hol-radius-card, 8px);
		padding: 1rem;
		background: var(--hol-surface, transparent);
		box-shadow: var(--hol-shadow, none);
		overflow: clip;
	}

	.hol-week-card-header {
		display: grid;
		gap: 0.35rem;
	}

	.hol-week-card-kicker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
	}

	.hol-week-number,
	.hol-week-date,
	.hol-week-tags span,
	.hol-week-milestones span {
		display: inline-flex;
		align-items: center;
		border-radius: var(--hol-radius, 6px);
		white-space: nowrap;
	}

	.hol-week-number {
		border: 1px solid color-mix(in oklab, var(--hol-blue, var(--sl-color-accent)), var(--hol-border, var(--sl-color-gray-5)) 55%);
		padding: 0.18rem 0.6rem;
		background: color-mix(in oklab, var(--hol-blue, var(--sl-color-accent)), transparent 91%);
		color: var(--hol-ink, var(--sl-color-gray-1));
		font-weight: 750;
	}

	.hol-week-date {
		color: var(--sl-color-gray-3);
		font-family: var(--__sl-font-mono);
		font-size: 0.82rem;
	}

	.hol-week-card h2 {
		margin: 0;
		color: var(--hol-ink, var(--sl-color-white));
		font-size: clamp(1.2rem, 2.5vw, 1.55rem);
		line-height: 1.15;
		letter-spacing: 0;
	}

	.hol-week-lecture {
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: 0.98rem;
	}

	.hol-week-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.85rem;
	}

	.hol-week-tags span {
		border: 1px solid var(--hol-border, var(--sl-color-gray-5));
		padding: 0.14rem 0.52rem;
		background: color-mix(in oklab, var(--hol-surface-2, var(--sl-color-gray-7)), transparent 20%);
		color: var(--sl-color-gray-2);
		font-size: 0.78rem;
		font-weight: 650;
		text-transform: lowercase;
	}

	.hol-week-card h3 {
		color: var(--sl-color-gray-3);
		font-family: var(--__sl-font-mono);
		font-size: 0.78rem;
		font-weight: 750;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.hol-week-card-grid p {
		margin: 0.25rem 0 0;
		color: var(--sl-color-gray-1);
	}

	.hol-week-card-grid {
		display: grid;
		gap: 0.85rem;
		margin-top: 0.9rem;
	}

	.hol-week-card-grid section {
		min-width: 0;
		margin-top: 0;
	}

	.hol-week-card h3 {
		margin: 0;
	}

	.hol-week-milestones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.35rem;
	}

	.hol-week-milestones span {
		border: 1px solid var(--hol-border, var(--sl-color-gray-5));
		padding: 0.18rem 0.58rem;
		background: color-mix(in oklab, var(--hol-surface-2, var(--sl-color-gray-7)), transparent 18%);
		color: var(--sl-color-gray-2);
		font-size: 0.82rem;
		font-weight: 700;
	}

	.hol-week-milestones span[data-kind='release'] {
		border-color: color-mix(in oklab, var(--hol-blue, var(--sl-color-accent)), var(--hol-border, var(--sl-color-gray-5)) 55%);
		background: color-mix(in oklab, var(--hol-blue, var(--sl-color-accent)), transparent 91%);
		color: var(--hol-ink, var(--sl-color-gray-1));
	}

	.hol-week-milestones span[data-kind='due'] {
		border-color: color-mix(in oklab, var(--hol-blue, var(--sl-color-accent)), var(--hol-border, var(--sl-color-gray-5)) 45%);
		background: color-mix(in oklab, var(--hol-blue, var(--sl-color-accent)), transparent 94%);
		color: var(--hol-ink, var(--sl-color-gray-1));
	}

	.hol-week-milestones span[data-kind='checkpoint'],
	.hol-week-milestones span[data-kind='demo'] {
		border-color: color-mix(in oklab, var(--sl-color-gray-3), var(--hol-border, var(--sl-color-gray-5)) 58%);
		background: color-mix(in oklab, var(--sl-color-gray-6), transparent 62%);
		color: var(--sl-color-gray-1);
	}

	.hol-week-details {
		margin-top: 0.85rem;
		border-top: 1px solid var(--sl-color-hairline);
		padding-top: 0.75rem;
	}

	.hol-week-details summary {
		cursor: pointer;
		color: var(--sl-color-gray-2);
		font-weight: 700;
	}

	.hol-week-details-body {
		display: grid;
		gap: 0.85rem;
		margin-top: 0.75rem;
	}

	.hol-week-details-body > * {
		min-width: 0;
		margin-top: 0;
	}

	.hol-week-details ul {
		margin: 0.35rem 0 0;
		padding-left: 1.2rem;
		color: var(--sl-color-gray-2);
	}

	.hol-week-note p {
		margin: 0.35rem 0 0;
		color: var(--sl-color-gray-2);
	}

	@media (min-width: 50rem) {
		.hol-week-card {
			padding: 1.1rem 1.15rem 1.15rem;
		}

		.hol-week-card-grid {
			grid-template-columns: minmax(0, 1.2fr) minmax(14rem, 0.8fr);
		}

		.hol-week-details-body {
			grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 0.6fr);
		}
	}
</style>
