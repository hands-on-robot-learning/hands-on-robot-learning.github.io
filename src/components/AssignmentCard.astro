---
type AssignmentTag = 'hardware' | 'data' | 'training' | 'eval' | 'demo';

export interface Props {
	title: string;
	href: string;
	due?: string;
	points?: number;
	tags?: AssignmentTag[];
	summary?: string;
}

const { title, href, due, points, tags = [], summary } = Astro.props;

const withBase = (url: string) => {
	if (
		url.startsWith('http://') ||
		url.startsWith('https://') ||
		url.startsWith('#') ||
		url.startsWith('mailto:') ||
		url.startsWith('tel:')
	) {
		return url;
	}

	const base = import.meta.env.BASE_URL ?? '/';
	const cleanBase = base.endsWith('/') ? base : `${base}/`;
	const cleanUrl = url.startsWith('/') ? url.slice(1) : url;
	return `${cleanBase}${cleanUrl}`;
};
---

<a class="hol-assignment-card" href={withBase(href)}>
	<div class="hol-assignment-top">
		<h3 class="hol-assignment-title">{title}</h3>
		{points ? <span class="hol-assignment-points">{points} pts</span> : null}
	</div>
	{summary ? <p class="hol-assignment-summary">{summary}</p> : null}
	<div class="hol-assignment-meta" aria-label="Assignment metadata">
		{due ? <span class="hol-assignment-pill">Due: {due}</span> : null}
		{tags.map((tag) => (
			<span class="hol-assignment-pill" data-tag={tag}>
				{tag}
			</span>
		))}
	</div>
</a>

<style>
	.hol-assignment-card {
		display: block;
		border: 1px solid var(--hol-border, var(--sl-color-gray-5));
		border-radius: var(--hol-radius-card, 8px);
		padding: 1rem;
		text-decoration: none;
		background: var(--hol-surface, color-mix(in oklab, var(--sl-color-gray-7), transparent 65%));
		box-shadow: var(--hol-shadow, none);
		transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
	}
	.hol-assignment-card:hover,
	.hol-assignment-card:focus-visible {
		transform: translateY(-1px);
		border-color: var(--hol-blue, var(--sl-color-accent));
		background: color-mix(in oklab, var(--hol-blue, var(--sl-color-accent)), var(--hol-surface, transparent) 90%);
	}
	.hol-assignment-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.hol-assignment-title {
		margin: 0;
	}
	.hol-assignment-summary {
		margin: 0.4rem 0 0.8rem;
		color: var(--sl-color-gray-2);
	}
	.hol-assignment-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.hol-assignment-pill {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--hol-border, var(--sl-color-gray-5));
		border-radius: var(--hol-radius, 6px);
		padding: 0.15rem 0.55rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
		background: color-mix(in oklab, var(--sl-color-gray-7), transparent 60%);
	}
	.hol-assignment-points {
		color: var(--sl-color-gray-2);
		font-size: 0.9rem;
		white-space: nowrap;
	}
</style>
