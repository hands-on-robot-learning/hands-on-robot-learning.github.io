---
export interface Props {
	title?: string;
	items: string[];
}

const { title = 'Checklist', items } = Astro.props;
---

<section class="hol-checklist" aria-label={title}>
	<h3 class="hol-checklist-title">{title}</h3>
	<ul class="hol-checklist-list">
		{items.map((item) => (
			<li class="hol-checklist-item">
				<input type="checkbox" disabled aria-hidden="true" />
				<span>{item}</span>
			</li>
		))}
	</ul>
</section>

<style>
	.hol-checklist {
		border: 1px solid var(--hol-border, var(--sl-color-gray-5));
		border-radius: var(--hol-radius-card, 8px);
		padding: 1rem;
		background: var(--hol-surface, color-mix(in oklab, var(--sl-color-gray-7), transparent 70%));
		margin: 1rem 0;
	}
	.hol-checklist-title {
		margin: 0 0 0.6rem;
		font-size: 1.05rem;
	}
	.hol-checklist-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.45rem;
	}
	.hol-checklist-item {
		display: grid;
		grid-template-columns: 1.2rem 1fr;
		gap: 0.55rem;
		align-items: start;
	}
	.hol-checklist-item input {
		margin-top: 0.15rem;
	}
</style>
